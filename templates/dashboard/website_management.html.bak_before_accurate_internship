function switchJourneyTab(tabKey, btn) {







  const tabs = document.querySelectorAll('#journeySectionTabs .btn-home-subtab');







  tabs.forEach(b => b.classList.remove('active'));







  if (btn) {







    btn.classList.add('active');







  } else {







    const matchingBtn = document.querySelector(`#journeySectionTabs .btn-home-subtab[data-tab="${tabKey}"]`);







    if (matchingBtn) matchingBtn.classList.add('active');







  }















  const cards = document.querySelectorAll('.journey-section-card');







  if (tabKey === 'all' || !tabKey) {







    cards.forEach(c => c.style.display = 'block');







  } else {







    cards.forEach(c => {







      if (c.getAttribute('data-section') === tabKey) {







        c.style.display = 'block';







        c.scrollIntoView({ behavior: 'smooth', block: 'start' });







      } else {







        c.style.display = 'none';







      }







    });







  }







  try {







    localStorage.setItem('svg_active_journey_tab', tabKey || 'all');







  } catch(e) {}







}















