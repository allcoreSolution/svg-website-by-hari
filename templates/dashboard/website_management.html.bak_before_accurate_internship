  document.getElementById('internFaqModalTitle').innerText = isEdit ? 'Edit FAQ Item' : 'Add FAQ Item';
  document.getElementById('internFaqModalIndex').value = isEdit ? index : '';
  if (isEdit && index !== null) {
    const item = internFaqsData[index];
    document.getElementById('internFaqModalId').value = item.id || '';
    document.getElementById('internFaqModalQuestionInput').value = item.question || '';
    document.getElementById('internFaqModalAnswerInput').value = item.answer || '';
    document.getElementById('internFaqModalVisibleInput').checked = item.is_visible !== false;
  } else {
    document.getElementById('internFaqModalId').value = '';
    document.getElementById('internFaqModalQuestionInput').value = '';
    document.getElementById('internFaqModalAnswerInput').value = '';
    document.getElementById('internFaqModalVisibleInput').checked = true;
  }
  openInternModalGeneric('internFaqModal');
}
function editInternFaq(idx) { openInternFaqModal(true, idx); }
function deleteInternFaq(idx) {
  if (confirm('Delete this FAQ item?')) {
    internFaqsData.splice(idx, 1);
    renderInternFaqsTable();
    syncAllInternshipJson();
  }
}
function moveInternFaq(idx, dir) {
  const newIdx = idx + dir;
  if (newIdx < 0 || newIdx >= internFaqsData.length) return;
  const temp = internFaqsData[idx];
  internFaqsData[idx] = internFaqsData[newIdx];
  internFaqsData[newIdx] = temp;
  renderInternFaqsTable();
  syncAllInternshipJson();
}
function saveInternFaqModal() {
  const q = document.getElementById('internFaqModalQuestionInput').value.trim();
  if (!q) { alert('Please enter question'); return; }
  const a = document.getElementById('internFaqModalAnswerInput').value.trim();
  const visible = document.getElementById('internFaqModalVisibleInput').checked;
  const idxStr = document.getElementById('internFaqModalIndex').value;
  const idVal = document.getElementById('internFaqModalId').value;
  if (idxStr !== '') {
    const idx = parseInt(idxStr, 10);
    internFaqsData[idx].question = q;
    internFaqsData[idx].answer = a;
    internFaqsData[idx].is_visible = visible;
  } else {
    internFaqsData.push({
      id: idVal ? parseInt(idVal, 10) : null,
      question: q,
      answer: a,
      order: internFaqsData.length + 1,
      is_visible: visible
    });
  }
  closeInternModal('internFaqModal');
  renderInternFaqsTable();
  syncAllInternshipJson();
}

// -------------------------------------------------------------------------
// MASTER JSON SYNC
// -------------------------------------------------------------------------
function syncAllInternshipJson() {
  const stripInput = document.getElementById('intern_strip_json');
  if (stripInput) stripInput.value = JSON.stringify(internStripData);

  const tracksInput = document.getElementById('intern_tracks_json');
  if (tracksInput) tracksInput.value = JSON.stringify(internTracksData);

  const hlInput = document.getElementById('intern_highlights_json');
  if (hlInput) hlInput.value = JSON.stringify(internHighlightsData);

  const whoInput = document.getElementById('intern_who_json');
  if (whoInput) whoInput.value = JSON.stringify(internWhoData);

  const learnInput = document.getElementById('intern_learn_json');
  if (learnInput) learnInput.value = JSON.stringify(internLearnData);

  const procInput = document.getElementById('intern_process_json');
  if (procInput) procInput.value = JSON.stringify(internProcessData);

  const benInput = document.getElementById('intern_benefits_json');
  if (benInput) benInput.value = JSON.stringify(internBenefitsData);

  const faqInput = document.getElementById('intern_faqs_json');
  if (faqInput) faqInput.value = JSON.stringify(internFaqsData);
}

document.addEventListener('DOMContentLoaded', function() {
  const isInternshipPage = (new URLSearchParams(window.location.search)).get('page') === 'internship';
  if (isInternshipPage) {
    renderInternStripTable();
    renderInternTracksTable();
    renderInternHighlightsTable();
    renderInternWhoTable();
    renderInternLearnTable();
    renderInternProcessTable();
    renderInternBenefitsTable();
    renderInternFaqsTable();

    const urlParams = new URLSearchParams(window.location.search);
    const tabFromUrl = urlParams.get('tab');
    let targetTab = tabFromUrl || localStorage.getItem('svg_active_intern_tab') || 'all';
    switchInternshipTab(targetTab);
  }
});


</script>







