function editHrEeBenefit(index) { openHrEeBenefitModal(true, index); }



function saveHrEeBenefitModal() {

  const idxVal = document.getElementById('hrEeBenefitModalIndex').value;

  const idVal = document.getElementById('hrEeBenefitModalId').value;

  const tVal = document.getElementById('hrEeBenefitModalTitleInput').value.trim();

  const vVal = document.getElementById('hrEeBenefitModalVisibleInput').checked;

  if (!tVal) { alert('Please enter a benefit title.'); return; }

  const obj = { id: idVal ? parseInt(idVal) : null, title: tVal, order: idxVal !== '' ? hrEmployeeBenefitsData[parseInt(idxVal)].order : (hrEmployeeBenefitsData.length + 1), is_visible: vVal };

  if (idxVal !== '') { hrEmployeeBenefitsData[parseInt(idxVal)] = obj; } else { hrEmployeeBenefitsData.push(obj); }

  renderHrEmployeeBenefitsTable();

  closeHrModal('hrEeBenefitModal');

}



function moveHrEeBenefit(index, dir) {

  const target = index + dir;

  if (target < 0 || target >= hrEmployeeBenefitsData.length) return;

  const temp = hrEmployeeBenefitsData[index];

  hrEmployeeBenefitsData[index] = hrEmployeeBenefitsData[target];

  hrEmployeeBenefitsData[target] = temp;

  hrEmployeeBenefitsData.forEach((item, idx) => item.order = idx + 1);

  renderHrEmployeeBenefitsTable();

}



function deleteHrEeBenefit(index) {

  if (!confirm('Are you sure you want to delete this benefit?')) return;

  hrEmployeeBenefitsData.splice(index, 1);

  hrEmployeeBenefitsData.forEach((item, idx) => item.order = idx + 1);

  renderHrEmployeeBenefitsTable();

}



