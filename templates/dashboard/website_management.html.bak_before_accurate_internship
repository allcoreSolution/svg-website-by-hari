<script>







function showSaveToast(message) {







  const toast = document.getElementById('wmSaveToast');







  const msgEl = document.getElementById('wmToastMsg');







  if (toast && msgEl) {







    msgEl.textContent = message || 'Settings updated successfully!';







    toast.style.display = 'inline-flex';







    setTimeout(() => {







      toast.style.display = 'none';







    }, 3000);







  }







}















// Image Live Preview







function previewImage(input, previewId) {







  if (input.files && input.files[0]) {







    const reader = new FileReader();







    reader.onload = function(e) {







      const preview = document.getElementById(previewId);







      if (preview) {







        preview.src = e.target.result;







      }







    };







    reader.readAsDataURL(input.files[0]);







  }







}















// Global HTML Escaper (available across all subtabs)







function escapeHtml(text) {







  if (text === null || text === undefined) return '';







  return String(text)







    .replace(/&/g, '&amp;')







    .replace(/</g, '&lt;')







    .replace(/>/g, '&gt;')







    .replace(/"/g, '&quot;')







    .replace(/'/g, '&#039;');







}















{% if active_sub == 'header_footer' %}







// --- PRIMARY NAV ITEMS BUILDER ---







let navItems = [];







try {







  navItems = {{ nav_items_json_init|default:"[]"|safe }};







} catch (e) {







  navItems = [];







}















function syncNavJson() {







  const input = document.getElementById('nav_items_json');







  if (input) {







    input.value = JSON.stringify(navItems);







  }







}















function renderNavTable() {







  const tbody = document.getElementById('navItemsTableBody');







  const badge = document.getElementById('navItemCountBadge');







  if (!tbody) return;















  if (badge) {







    badge.textContent = `${navItems.length} Items`;







  }















  if (navItems.length === 0) {







    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:24px; color:#64748B;">No menu items found. Click "+ Add Menu Item" to create one.</td></tr>`;







    syncNavJson();







    return;







  }















  // Pre-calculate top-level items for parent dropdown







  const topLevelOptions = [];







  navItems.forEach((item, idx) => {







    if (item.parent_idx === null || item.parent_idx === undefined || item.parent_idx === "") {







      topLevelOptions.push({ idx: idx, label: item.label || `Item #${idx + 1}` });







    }







  });















  let html = '';







  navItems.forEach((item, idx) => {







    const isChild = (item.parent_idx !== null && item.parent_idx !== undefined && item.parent_idx !== "");







    const rowBg = isChild ? '#F8FAFC' : '#FFFFFF';















    // Parent select options







    let parentOpts = `<option value="">None (Top Level)</option>`;







    topLevelOptions.forEach(topOpt => {







      if (topOpt.idx !== idx) {







        const selected = (item.parent_idx !== null && parseInt(item.parent_idx) === topOpt.idx) ? 'selected' : '';







        parentOpts += `<option value="${topOpt.idx}" ${selected}>Submenu of: ${escapeHtml(topOpt.label)}</option>`;







      }







    });















    html += `







      <tr style="background:${rowBg}; border-left:${isChild ? '3px solid #2563EB' : 'none'};">







        <td style="text-align:center; font-weight:700; color:#64748B; font-size:12px;">${idx + 1}</td>







        <td>







          <div style="display:flex; align-items:center; gap:6px;">







            ${isChild ? '<i class="ti ti-corner-down-right text-primary" style="font-size:14px; margin-left:8px;"></i>' : ''}







            <input type="text" class="wm-input wm-input-sm" value="${escapeHtml(item.label || '')}" placeholder="Menu Label" oninput="updateNavField(${idx}, 'label', this.value)">







          </div>







        </td>







        <td>







          <input type="text" class="wm-input wm-input-sm" value="${escapeHtml(item.url || '/')}" placeholder="/url-path/" oninput="updateNavField(${idx}, 'url', this.value)">







        </td>







        <td>







          <select class="wm-select wm-select-sm" onchange="updateNavParent(${idx}, this.value)">







            ${parentOpts}







          </select>







        </td>







        <td>







          <input type="text" class="wm-input wm-input-sm" value="${escapeHtml(item.active_key || '')}" placeholder="e.g. about" oninput="updateNavField(${idx}, 'active_key', this.value)">







        </td>







        <td style="text-align:center;">







          <input type="checkbox" ${item.is_visible ? 'checked' : ''} onchange="updateNavField(${idx}, 'is_visible', this.checked)">







        </td>







        <td style="text-align:center;">







          <input type="checkbox" ${item.new_tab ? 'checked' : ''} onchange="updateNavField(${idx}, 'new_tab', this.checked)">







        </td>







        <td style="text-align:center;">







          <div style="display:inline-flex; gap:4px; align-items:center;">







            <button type="button" class="wm-btn-icon" title="Move Up" onclick="moveNavItem(${idx}, -1)" ${idx === 0 ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''}>







              <i class="ti ti-arrow-up"></i>







            </button>







            <button type="button" class="wm-btn-icon" title="Move Down" onclick="moveNavItem(${idx}, 1)" ${idx === navItems.length - 1 ? 'disabled style="opacity:0.4; cursor:not-allowed;"' : ''}>







              <i class="ti ti-arrow-down"></i>







            </button>







            <button type="button" class="wm-btn-icon wm-btn-icon-danger" title="Delete" onclick="removeNavItem(${idx})">







              <i class="ti ti-trash"></i>







            </button>







          </div>







        </td>







      </tr>







    `;







  });















  tbody.innerHTML = html;







  syncNavJson();







}















function updateNavField(idx, field, value) {







  if (navItems[idx]) {







    navItems[idx][field] = value;







    syncNavJson();







  }







}















function updateNavParent(idx, parentVal) {







  if (navItems[idx]) {







    navItems[idx].parent_idx = (parentVal === "" ? null : parseInt(parentVal));







    renderNavTable();







  }







}















function addNavItem() {







  navItems.push({







    label: 'New Link',







    url: '/',







    active_key: '',







    order: navItems.length + 1,







    is_visible: true,







    new_tab: false,







    parent_idx: null







  });







  renderNavTable();







}















function removeNavItem(idx) {







  if (confirm(`Are you sure you want to remove "${navItems[idx].label || 'this item'}"?`)) {







    // If deleted item was a parent, re-assign children to root







    navItems.forEach((it, i) => {







      if (it.parent_idx === idx) {







        it.parent_idx = null;







      } else if (it.parent_idx > idx) {







        it.parent_idx -= 1;







      }







    });







    navItems.splice(idx, 1);







    renderNavTable();







  }







}















function moveNavItem(idx, dir) {







  const targetIdx = idx + dir;







  if (targetIdx < 0 || targetIdx >= navItems.length) return;







  const temp = navItems[idx];







  navItems[idx] = navItems[targetIdx];







  navItems[targetIdx] = temp;







  renderNavTable();







}























