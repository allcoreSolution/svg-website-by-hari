// Heading Synchronizers with Highlight Spans







function updateTeamHeadingWithHighlight(titleId, hlId, hiddenId, previewId, fallbackDefault) {







  const titleInput = document.getElementById(titleId);







  const hlInput = document.getElementById(hlId);







  const hiddenInput = document.getElementById(hiddenId);







  const preview = document.getElementById(previewId);







  if (!titleInput || !hiddenInput) return;















  let title = (titleInput.value || '').trim();







  title = title.replace(/<[^>]+>/g, '').trim();







  const hl = (hlInput ? hlInput.value || '' : '').trim();















  let finalHtml = title;







  let previewHtml = escapeHtml(title);















  if (hl && title) {







    const escapedHl = hl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');







    const regex = new RegExp(`(${escapedHl})`, 'i');







    if (regex.test(title)) {







      finalHtml = title.replace(regex, '<span>$1</span>');







      previewHtml = escapeHtml(title).replace(new RegExp(`(${escapeHtml(hl)})`, 'i'), '<span style="color:#dc2626; font-weight:700;">$1</span>');







    }







  }















  hiddenInput.value = finalHtml || fallbackDefault;







  if (preview) {







    preview.innerHTML = previewHtml || '<em>No title entered</em>';







  }







}















