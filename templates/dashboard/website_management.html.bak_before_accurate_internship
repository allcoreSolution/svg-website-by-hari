function escapeHtml(text) {







  if (text === null || text === undefined) return '';







  return String(text)







    .replace(/&/g, '&amp;')







    .replace(/</g, '&lt;')







    .replace(/>/g, '&gt;')







    .replace(/"/g, '&quot;')







    .replace(/'/g, '&#039;');







}















function previewImageFile(input, imgId) {







  if (input.files && input.files[0]) {







    const reader = new FileReader();







    reader.onload = function(e) {







      const el = document.getElementById(imgId);







      if (el) el.src = e.target.result;







    };







    reader.readAsDataURL(input.files[0]);







  }







}















function switchManpowerTab(tabKey, btn) {







  const tabs = document.querySelectorAll('#manpowerSectionTabs .btn-home-subtab');







  tabs.forEach(b => b.classList.remove('active'));







  if (btn) {







    btn.classList.add('active');







  } else {







    const matchingBtn = document.querySelector(`#manpowerSectionTabs .btn-home-subtab[data-tab="${tabKey}"]`);







    if (matchingBtn) matchingBtn.classList.add('active');







  }















  const cards = document.querySelectorAll('.manpower-section-card');







  if (tabKey === 'all' || !tabKey) {







    cards.forEach(c => c.style.display = 'block');







  } else {







    cards.forEach(c => {







      if (c.getAttribute('data-section') === tabKey) {







        c.style.display = 'block';







        if (btn) {







          c.scrollIntoView({ behavior: 'smooth', block: 'start' });







        }







      } else {







        c.style.display = 'none';







      }







    });







  }







  try {







    localStorage.setItem('svg_active_manpower_tab', tabKey || 'all');







  } catch(e) {}







}















