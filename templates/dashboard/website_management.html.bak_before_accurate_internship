  .then(res => res.json())







  .then(data => {







    if (data.status === 'success' && data.image_url) {







      const urlInput = document.getElementById('td_image_url');







      if (urlInput) urlInput.value = data.image_url;







      updateDepartmentModalPreview(data.image_url);







