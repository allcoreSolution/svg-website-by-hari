function switchInternshipTab(tabKey) {
  const allBtns = document.querySelectorAll('.btn-intern-tab');
  allBtns.forEach(btn => {
    if (btn.getAttribute('data-tab') === tabKey) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });

  const allCards = document.querySelectorAll('.intern-section-card');
  if (tabKey === 'all') {
    allCards.forEach(c => c.style.display = 'block');
  } else {
    allCards.forEach(c => {
      if (c.getAttribute('data-section') === tabKey) {
        c.style.display = 'block';
      } else {
        c.style.display = 'none';
      }
    });
  }

  const activeInput = document.getElementById('intern_active_tab');
  if (activeInput) activeInput.value = tabKey;
  try {
    localStorage.setItem('svg_active_intern_tab', tabKey);
  } catch(e) {}
}

function closeInternModal(modalId) {
  const m = document.getElementById(modalId);
  if (m) m.style.display = 'none';
}

function openInternModalGeneric(modalId) {
  const m = document.getElementById(modalId);
  if (m) {
    m.style.display = 'flex';
  }
}

// Instant AJAX Toggle for Repeaters
function toggleInternItemVisibleAjax(itemType, itemId, isVisible, checkboxElem) {
  if (!itemId) {
    syncAllInternshipJson();
    return;
  }
  const csrftoken = (document.querySelector('[name=csrfmiddlewaretoken]') || {}).value || '';
  fetch('/admin-panel/website/services/api/toggle-repeater-visible/', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRFToken': csrftoken
    },
    body: JSON.stringify({
      item_type: itemType,
      item_id: itemId,
      is_visible: isVisible
    })
  })
  .then(res => res.json())
  .then(data => {
    if (data.status !== 'success') {
      alert('Error updating visibility: ' + (data.message || 'Unknown error'));
      if (checkboxElem) checkboxElem.checked = !isVisible;
    } else {
      syncAllInternshipJson();
    }
  })
  .catch(err => {
    console.error('AJAX toggle failed:', err);
    if (checkboxElem) checkboxElem.checked = !isVisible;
  });
}

