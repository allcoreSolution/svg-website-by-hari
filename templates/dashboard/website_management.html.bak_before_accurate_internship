document.addEventListener('DOMContentLoaded', function() {







  renderMsChecklist();







  renderMsServices();







  renderMsIndustries();







  renderMsWhyChoose();







  renderMsProcess();







  renderMsStats();







  renderMsFaqs();







  renderMsTrust();















  const msForm = document.getElementById('manpowerSupplyForm');







  if (msForm) {







    // Two-way synchronization for duplicate switches (Master Visibility Card <-> Individual Section Card Headers)







    msForm.addEventListener('change', function(e) {







      if (e.target && e.target.type === 'checkbox' && e.target.name) {







        const matches = msForm.querySelectorAll(`input[type="checkbox"][name="${e.target.name}"]`);







        if (matches.length > 1) {







          matches.forEach(cb => {







            if (cb !== e.target) cb.checked = e.target.checked;







          });







        }







      }







    });















    msForm.addEventListener('submit', function() {







      syncAllManpowerSupplyJson();







      const seen = new Set();







      msForm.querySelectorAll('input[type="checkbox"]').forEach(cb => {







        if (!cb.name || seen.has(cb.name)) return;







        seen.add(cb.name);







        const matches = msForm.querySelectorAll(`input[type="checkbox"][name="${cb.name}"]`);







        if (matches.length > 1) {







          const anyChecked = Array.from(matches).some(m => m.checked);







          matches.forEach(m => m.checked = anyChecked);







        }







      });







    });















    const savedTab = localStorage.getItem('svg_active_manpower_tab') || 'all';







    switchManpowerTab(savedTab);







  }







});















