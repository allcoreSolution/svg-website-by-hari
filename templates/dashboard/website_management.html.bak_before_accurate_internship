function switchRpTab(tabKey, btn) {







  const tabs = document.querySelectorAll('#rpSectionTabs .btn-home-subtab');







  tabs.forEach(b => b.classList.remove('active'));







  if (btn) {







    btn.classList.add('active');







  } else {







    const matchingBtn = document.querySelector(`#rpSectionTabs .btn-home-subtab[data-tab="${tabKey}"]`);







    if (matchingBtn) matchingBtn.classList.add('active');







  }















  const cards = document.querySelectorAll('.rp-section-card');







  if (tabKey === 'all' || !tabKey) {







    cards.forEach(c => c.style.display = 'block');







  } else {







    cards.forEach(c => {







      if (c.getAttribute('data-section') === tabKey) {







        c.style.display = 'block';







        if (btn) {







          c.scrollIntoView({ behavior: 'smooth', block: 'start' });







        }







      } else {







        c.style.display = 'none';







      }







    });







  }







  try {







    localStorage.setItem('svg_active_rp_tab', tabKey || 'all');







  } catch(e) {}







}















