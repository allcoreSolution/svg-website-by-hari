  fetch('/api/admin/website/upload-image/', {







    method: 'POST',







    body: formData







  })







  .then(res => res.json())







  .then(data => {







    if (data.status === 'success' && data.image_url) {







      if (galleryImages[idx]) {







        galleryImages[idx].static_image_path = data.image_url;







        galleryImages[idx].image_url = data.image_url;







