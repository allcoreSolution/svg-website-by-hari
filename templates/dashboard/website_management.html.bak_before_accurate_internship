    // Checkbox two-way sync







    rpForm.addEventListener('change', function(e) {







      if (e.target && e.target.type === 'checkbox' && e.target.name) {







        const name = e.target.name;







        const checked = e.target.checked;







        const matches = rpForm.querySelectorAll(`input[type="checkbox"][name="${name}"]`);







        if (matches.length > 1) {







          matches.forEach(m => { if (m !== e.target) m.checked = checked; });







        }







      }







    });















    rpForm.addEventListener('submit', function() {







      syncAllRecruitmentPlacementJson();







      const seen = new Set();







      rpForm.querySelectorAll('input[type="checkbox"]').forEach(cb => {







        if (!cb.name || seen.has(cb.name)) return;







        seen.add(cb.name);







        const matches = rpForm.querySelectorAll(`input[type="checkbox"][name="${cb.name}"]`);







        if (matches.length > 1) {







          const anyChecked = Array.from(matches).some(m => m.checked);







          matches.forEach(m => m.checked = anyChecked);







        }







      });







    });















    const savedTab = localStorage.getItem('svg_active_rp_tab') || 'all';







    switchRpTab(savedTab);







  }







});















