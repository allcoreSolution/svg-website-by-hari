// --- Sub-Tabs Switcher with Persistence ---







function switchCsTab(tabId, el) {







  tabId = tabId || 'all';







  const tabs = document.querySelectorAll('#csSectionTabs .btn-website-tab');







  tabs.forEach(b => b.classList.remove('active'));















  if (el) {







    el.classList.add('active');







  } else {







    const matchingBtn = document.getElementById('tab-cs-' + tabId);







    if (matchingBtn) {







      matchingBtn.classList.add('active');







    } else {







      const allBtn = document.getElementById('tab-cs-all');







      if (allBtn) allBtn.classList.add('active');







    }







  }















  const cards = document.querySelectorAll('.cs-section-card');







  if (tabId === 'all') {







    cards.forEach(c => c.style.display = 'block');







  } else {







    cards.forEach(c => {







      if (c.id === 'cs-sec-' + tabId) {







        c.style.display = 'block';







        if (el) {







          c.scrollIntoView({ behavior: 'smooth', block: 'start' });







        }







      } else {







        c.style.display = 'none';







      }







    });







  }















  const activeInput = document.getElementById('cs_active_tab');







  if (activeInput) activeInput.value = tabId;















  try {







    localStorage.setItem('svg_active_cs_tab', tabId);







  } catch(e) {}







}















