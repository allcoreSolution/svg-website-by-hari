// Initialize tables & listeners if on Contract Staffing page







document.addEventListener('DOMContentLoaded', function() {







  const csForm = document.getElementById('contractStaffingForm');







  if (csForm) {







    renderCsServicesTable();







    renderCsIndustriesTable();







    renderCsWhyChooseTable();







    renderCsProcessTable();







    renderCsEmployerBenefitsTable();







    renderCsCandidateBenefitsTable();







    renderCsFaqsTable();







    syncAllContractStaffingJson();















    // Two-way checkbox synchronization across duplicate section toggles







    csForm.addEventListener('change', function(e) {







      if (e.target && e.target.type === 'checkbox' && e.target.name) {







        const name = e.target.name;







        const checked = e.target.checked;







        const matches = csForm.querySelectorAll(`input[type="checkbox"][name="${name}"]`);







        if (matches.length > 1) {







          matches.forEach(m => { if (m !== e.target) m.checked = checked; });







        }







      }







    });















    // Form submit listener







    csForm.addEventListener('submit', function() {







      syncAllContractStaffingJson();















      // Ensure Master Visibility switches are strictly respected on submit







      const masterCard = document.getElementById('cs-sec-master');







      if (masterCard) {







        masterCard.querySelectorAll('input[type="checkbox"]').forEach(masterCb => {







          if (!masterCb.name) return;







          const matches = csForm.querySelectorAll(`input[type="checkbox"][name="${masterCb.name}"]`);







          matches.forEach(m => m.checked = masterCb.checked);







        });







      }















      // Record current active tab in input and localStorage







      const activeBtn = document.querySelector('#csSectionTabs .btn-website-tab.active');







      const currentTab = activeBtn ? activeBtn.id.replace('tab-cs-', '') : 'all';







      const activeInput = document.getElementById('cs_active_tab');







      if (activeInput) activeInput.value = currentTab;







      try {







        localStorage.setItem('svg_active_cs_tab', currentTab);







      } catch(e) {}







    });















    // Check URL query param first, then localStorage, then default to 'all'







    const urlParams = new URLSearchParams(window.location.search);







    const tabFromUrl = urlParams.get('tab');







    let targetTab = tabFromUrl || localStorage.getItem('svg_active_cs_tab') || 'all';







    switchCsTab(targetTab);







  }







});































