  .catch(err => {







    console.error('Row upload error:', err);







    alert('Image upload failed. Please try again.');







  })







  .finally(() => {







    if (uploadBtn) {







      uploadBtn.innerHTML = '<i class="ti ti-upload"></i> Upload';







      uploadBtn.disabled = false;







    }







    input.value = '';







  });







