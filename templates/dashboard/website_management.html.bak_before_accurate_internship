        </div>







        <div style="background:#f8fafc; border:1px dashed #cbd5e1; border-radius:10px; padding:18px; text-align:center;">







          <div style="width:36px; height:36px; border-radius:8px; background:#2563eb; color:#ffffff; display:inline-flex; align-items:center; justify-content:center; font-weight:800; font-size:16px; margin-bottom:6px;">







            SVG







          </div>







          <div style="font-size:12px; font-weight:600; color:#334155;">Site Favicon (32x32)</div>







          <input type="file" class="wm-input mt-2" style="font-size:12px; margin-top:10px;">







        </div>







