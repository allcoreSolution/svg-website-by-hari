    input.value = '';







    return;







  }







  const formData = new FormData();







  formData.append('image', file);







  formData.append('csrfmiddlewaretoken', getCsrfToken());















  // Show temporary status on button







  const uploadBtn = document.getElementById(`galRowUploadBtn_${idx}`);







