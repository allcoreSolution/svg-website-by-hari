{% block content %}







<div class="website-mgmt-container" style="display:flex; flex-direction:column; gap:18px;">































  <!-- DJANGO MESSAGES DISPLAY -->







  {% if messages %}







  <div style="display:flex; flex-direction:column; gap:8px;">







    {% for msg in messages %}







    <div style="padding:12px 16px; border-radius:8px; font-size:13px; display:flex; align-items:center; justify-content:space-between; gap:12px;







      {% if msg.tags == 'error' %}background:#FEF2F2; color:#991B1B; border:1px solid #FCA5A5;







      {% elif msg.tags == 'warning' %}background:#FFFBEB; color:#92400E; border:1px solid #FCD34D;







      {% else %}background:#F0FDF4; color:#166534; border:1px solid #86EFAC;{% endif %}">







      <div style="display:flex; align-items:center; gap:8px;">







        <i class="ti {% if msg.tags == 'error' %}ti-alert-circle{% elif msg.tags == 'warning' %}ti-alert-triangle{% else %}ti-circle-check{% endif %}" style="font-size:18px;"></i>







        <span>{{ msg }}</span>







      </div>







      <button type="button" onclick="this.parentElement.remove()" style="background:none; border:none; color:inherit; cursor:pointer; font-size:16px;">&times;</button>







    </div>







    {% endfor %}







  </div>







  {% endif %}















  <!-- MODULE HEADER CARD -->







  {% if active_sub != 'services' or current_services_page == 'catalog' or not current_services_page %}







  <div class="module-header-card">







    <div class="module-title-group">







      <div class="module-icon-box" style="background:linear-gradient(135deg, #1e40af 0%, #2563eb 100%); color:#ffffff; box-shadow:0 4px 12px rgba(37,99,235,0.3);">







        <i class="ti {{ current_sec.icon }}"></i>







      </div>







      <div>







        <div style="display:flex; align-items:center; gap:8px; margin-bottom:2px;">







          <h2 style="font-size:18px; font-weight:700; color:#0f172a; margin:0;">{{ current_sec.title }}</h2>







          <span class="wm-badge wm-badge-primary">{{ current_sec.tag }}</span>







        </div>







        <span style="font-size:12px; color:#64748b;">{{ current_sec.subtitle }}</span>







      </div>







    </div>















    <div class="module-actions-group">







      <a href="{{ current_sec.live_url }}" target="_blank" class="btn-admin btn-admin-secondary" style="text-decoration:none;">







        <i class="ti ti-external-link"></i> View Live Page







      </a>







      {% if active_sub == 'header_footer' %}







      <button type="submit" form="headerFooterForm" class="btn-admin btn-admin-primary">







        <i class="ti ti-device-floppy"></i> Save Changes







      </button>







      {% elif active_sub == 'home' %}







      <button type="submit" form="homePageForm" onclick="syncAllHomeJsonInputs();" class="btn-admin btn-admin-primary">







        <i class="ti ti-device-floppy"></i> Save Changes







      </button>







      {% elif active_sub == 'about' %}







        {% if current_about_page == 'company' or not current_about_page %}







        <button type="submit" form="aboutCompanyForm" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_about_page == 'ceo' %}







        <button type="submit" form="aboutCeoForm" onclick="syncPrinciplesJson();" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_about_page == 'team' %}







        <button type="submit" form="aboutTeamForm" onclick="syncTeamMembersJson();" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_about_page == 'journey' %}







        <button type="submit" form="aboutJourneyForm" onclick="syncMilestonesJson();" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% endif %}







      {% elif active_sub == 'services' %}







        {% if current_services_page == 'manpower_supply' %}







        <button type="submit" form="manpowerSupplyForm" onclick="syncAllManpowerSupplyJson();" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_services_page == 'recruitment_placement' %}







        <button type="submit" form="recruitmentPlacementForm" onclick="syncAllRecruitmentPlacementJson();" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_services_page == 'contract_staffing' %}







        <button type="submit" form="contractStaffingForm" onclick="syncAllContractStaffingJson();" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_services_page == 'educational_consultancy' %}







        <button type="submit" form="educationalConsultancyForm" onclick="syncAllEducationalConsultancyJson();" class="btn-admin btn-admin-primary" style="background:#ea580c; border-color:#ea580c;">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% elif current_services_page == 'payroll_outsourcing' %}







        <button type="submit" form="payrollOutsourcingForm" onclick="syncAllPayrollOutsourcingJson();" class="btn-admin btn-admin-primary" style="background:#0d9488; border-color:#0d9488;">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        

        {% elif current_services_page == 'hr_support' %}

        <button type="submit" form="hrSupportForm" onclick="syncAllHrSupportJson();" class="btn-admin btn-admin-primary" style="background:#2563eb; border-color:#2563eb;">

          <i class="ti ti-device-floppy"></i> Save HR Support Configuration

        </button>

        {% elif current_services_page == 'internship' %}

        <button type="submit" form="internshipForm" onclick="syncAllInternshipJson();" class="btn-admin btn-admin-primary" style="background:#2563eb; border-color:#2563eb;">

          <i class="ti ti-device-floppy"></i> Save Internship Configuration

        </button>

{% else %}







        <button type="submit" form="serviceGenericForm" class="btn-admin btn-admin-primary">







          <i class="ti ti-device-floppy"></i> Save Changes







        </button>







        {% endif %}







      {% else %}







      <button type="button" class="btn-admin btn-admin-primary" onclick="showSaveToast('{{ current_sec.title }} saved successfully!');">







        <i class="ti ti-device-floppy"></i> Save Changes







      </button>







      {% endif %}







    </div>







  </div>







  {% endif %}















  <!-- ACTIVE SECTION CONTENT AREA -->















  <!-- 1. WEBSITE SETTINGS -->







