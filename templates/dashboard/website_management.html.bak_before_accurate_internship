function switchPoTab(tabName) {







  const tabBtns = document.querySelectorAll('.btn-po-tab');







  tabBtns.forEach(btn => {







    if (btn.getAttribute('data-tab') === tabName) {







      btn.classList.add('active');







    } else {







      btn.classList.remove('active');







    }







  });















  const cards = document.querySelectorAll('.po-section-card');







  cards.forEach(card => {







    if (tabName === 'all' || card.getAttribute('data-section') === tabName) {







      card.style.display = 'block';







    } else {







      card.style.display = 'none';







    }







  });















  const tabInput = document.getElementById('po_active_tab');







  if (tabInput) tabInput.value = tabName;















  try {







    localStorage.setItem('svg_active_po_tab', tabName);







  } catch(e) {}















  if (window.history && window.history.replaceState) {







    const url = new URL(window.location);







    if (tabName && tabName !== 'all') {







      url.searchParams.set('tab', tabName);







    } else {







      url.searchParams.delete('tab');







    }







    window.history.replaceState({}, '', url);







  }







}















// Initialize tables & listeners if on Payroll & Outsourcing page







document.addEventListener('DOMContentLoaded', function() {







  const poForm = document.getElementById('payrollOutsourcingForm');







  if (poForm) {







    renderPoServicesTable();







    renderPoIndustriesTable();







    renderPoWhyChooseTable();







    renderPoProcessTable();







    renderPoEmployerBenefitsTable();







    renderPoEmployeeBenefitsTable();







    renderPoFaqsTable();







    syncAllPayrollOutsourcingJson();















    // Two-way checkbox synchronization across duplicate section toggles







    poForm.addEventListener('change', function(e) {







      if (e.target && e.target.type === 'checkbox' && e.target.name) {







        const fieldName = e.target.name;







        const matchingCheckboxes = poForm.querySelectorAll(`input[type="checkbox"][name="${fieldName}"]`);







        if (matchingCheckboxes.length > 1) {







          matchingCheckboxes.forEach(cb => {







            if (cb !== e.target) {







              cb.checked = e.target.checked;







            }







          });







        }







      }







    });















    poForm.addEventListener('submit', function() {







      const activeTabInput = document.getElementById('po_active_tab');







      if (activeTabInput) {







        const activeBtn = document.querySelector('.btn-po-tab.active');







        if (activeBtn) {







          activeTabInput.value = activeBtn.getAttribute('data-tab') || 'all';







        }







      }







      syncAllPayrollOutsourcingJson();















      // Ensure Master Visibility switches are strictly respected on submit







      const masterCard = document.getElementById('po-sec-master');







      if (masterCard) {







        masterCard.querySelectorAll('input[type="checkbox"]').forEach(cb => {







          const sectionToggles = poForm.querySelectorAll(`input[type="checkbox"][name="${cb.name}"]`);







          sectionToggles.forEach(st => { st.checked = cb.checked; });







        });







      }







    });















    const urlParams = new URLSearchParams(window.location.search);







    const tabFromUrl = urlParams.get('tab');







    let targetTab = tabFromUrl || localStorage.getItem('svg_active_po_tab') || 'all';







    switchPoTab(targetTab);







  }







});



























