function handleGalleryModalFile(input) {







  if (!input.files || !input.files[0]) return;







  const file = input.files[0];







  if (file.size > 10 * 1024 * 1024) {







    alert("Image size exceeds 10MB. Please choose a smaller file.");







    input.value = '';







    return;







  }







  







  // Instant local preview







  const reader = new FileReader();







  reader.onload = function(e) {







    setGalModalPreview(e.target.result, 'Uploading photo to server...');







  };







  reader.readAsDataURL(file);















  const formData = new FormData();







  formData.append('image', file);







  formData.append('csrfmiddlewaretoken', getCsrfToken());















  fetch('/api/admin/website/upload-image/', {







    method: 'POST',







    body: formData







  })







  .then(res => res.json())







  .then(data => {







    if (data.status === 'success' && data.image_url) {







      const pathInput = document.getElementById('galModalPath');







      if (pathInput) pathInput.value = data.image_url;







      setGalModalPreview(data.image_url, 'Photo uploaded successfully!');







    } else {







      alert(data.message || 'Image upload failed.');







      clearGalModalImage();







    }







  })







  .catch(err => {







    console.error('Modal upload error:', err);







    alert('Image upload failed. Please try again.');







    clearGalModalImage();







  });







}















