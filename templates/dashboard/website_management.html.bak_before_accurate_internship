  <div class="wm-grid-2">







    <div class="wm-card">







      <h3 class="wm-card-title"><i class="ti ti-settings text-primary"></i> General Portal Identity &amp; Branding</h3>







      <form method="POST" onsubmit="event.preventDefault(); showSaveToast('Website Settings updated successfully!');">







