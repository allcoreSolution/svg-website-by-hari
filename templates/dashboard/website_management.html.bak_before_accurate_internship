        </div>







        <div class="wm-form-group">







          <label class="wm-label">Global Keywords</label>







          <input type="text" class="wm-input" name="meta_keywords" value="job consultancy lucknow, placement agency uttar pradesh, contract staffing, payroll solutions, candidate hiring">







        </div>















        <div style="display:flex; justify-content:flex-end; margin-top:16px;">







          <button type="submit" class="btn-admin btn-admin-primary"><i class="ti ti-check"></i> Update Website Settings</button>







        </div>







      </form>







    </div>















    <div>







      <div class="wm-card">







        <h3 class="wm-card-title"><i class="ti ti-photo text-primary"></i> Brand Logos &amp; Assets</h3>







        <div style="background:#f8fafc; border:1px dashed #cbd5e1; border-radius:10px; padding:18px; text-align:center; margin-bottom:14px;">







          <div style="font-weight:700; font-size:16px; color:#1e40af; margin-bottom:6px;">SVG CONSULTANCY</div>







          <div style="font-size:12px; font-weight:600; color:#334155;">Primary Header Logo</div>







          <div style="font-size:11px; color:#64748b; margin-top:2px;">Recommended: PNG or SVG with transparent background</div>







