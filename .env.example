# Sky Vision Group - Django Configuration
# In production set a secure 50+ character random secret key (e.g. via python -c 'import secrets; print(secrets.token_urlsafe(50))')
SECRET_KEY=your-production-secret-key-at-least-50-chars-random
DEBUG=False
ALLOWED_HOSTS=skyvisiongroup.in,www.skyvisiongroup.in,127.0.0.1,localhost
SITE_URL=https://skyvisiongroup.in

# Security & SSL Settings (Active when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSRF_TRUSTED_ORIGINS=https://skyvisiongroup.in,https://www.skyvisiongroup.in

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=https://skyvisiongroup.in,https://www.skyvisiongroup.in,http://127.0.0.1:8000,http://localhost:8000

# Database
# Leave blank for default SQLite database in database/database.db

# Email Settings (Gmail SMTP)
# Set EMAIL_HOST_USER and EMAIL_HOST_PASSWORD (16-char App Password from Google Account) to enable real sending.
# If credentials are empty, the system runs in Test/Console Mode (emails printed to console, not actually sent).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Sky Vision Group <your@gmail.com>"
EMAIL_TIMEOUT=20

# Communication Module Configuration
COMM_EMAIL_DAILY_LIMIT=400        # Maximum emails sent per 24h rolling/calendar day
COMM_EMAIL_BATCH_SIZE=20          # Recipients per SMTP connection
COMM_EMAIL_DELAY_SECONDS=1        # Delay in seconds between email batches
COMM_REPLY_TO=                    # Optional Reply-To email address
COMM_ENABLE_SMS_WHATSAPP=False    # Gate SMS/WhatsApp features (default: False)
COMM_STALE_SENDING_MINUTES=10     # Threshold (minutes) after which inactive 'Sending' broadcasts become 'Interrupted'
COMM_MAX_ATTACHMENT_MB=5          # Maximum allowed attachment size in MB (default: 5 MB)
